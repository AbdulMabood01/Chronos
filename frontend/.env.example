# Frontend Environment Variables Template
# Copy this file to .env.local and fill in the values for your environment

# Backend API Configuration
VITE_API_URL=http://localhost:8080/api

# Proxy Configuration (handled in vite.config.js for development)
# /api requests will be proxied to http://localhost:8080/api

# Application Configuration
VITE_APP_NAME=Chronos
VITE_APP_VERSION=1.0.0

# Microsoft Entra ID Configuration (for production)
VITE_MSAL_CLIENT_ID=your-client-id-here
VITE_MSAL_TENANT_ID=your-tenant-id-here
VITE_MSAL_REDIRECT_URI=http://localhost:5173
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here
VITE_MSAL_SCOPES=api://chronos/.default

# Build Configuration
VITE_BUILD_TARGET=es2020
