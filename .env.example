# Backend Environment Variables Template
# Copy this file to .env and fill in the values for your environment

# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/chronos_dev
DATABASE_USERNAME=chronos_user
DATABASE_PASSWORD=chronos_password
DATABASE_DRIVER=org.postgresql.Driver

# JPA/Hibernate Configuration
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_HIBERNATE_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Flyway Database Migration
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# OAuth2 / Microsoft Entra ID Configuration
OAUTH2_ISSUER_URI=https://login.microsoftonline.com/common
OAUTH2_JWK_SET_URI=https://login.microsoftonline.com/common/discovery/v2.0/keys
OAUTH2_AUDIENCE=api://chronos

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_MAXWELL_CHRONOS=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG

# Application Name
APPLICATION_NAME=Chronos
APPLICATION_VERSION=1.0.0

# Email Configuration (Optional, for future email notifications)
SPRING_MAIL_HOST=smtp.office365.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=noreply@maxwellnetwork.org
SPRING_MAIL_PASSWORD=your-password-here
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_FROM=noreply@maxwellnetwork.org
