# Backend Environment Variables Template
# Copy this file to .env and fill in the values for your environment.
# Keep .env private and load it into the backend process through your deployment manager.

# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://db-host:5432/chronos
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_DRIVER=org.postgresql.Driver

# Generate at least 32 random bytes and Base64 encode them. Keep this value stable
# across restarts and identical on every backend instance.
JWT_SIGNING_KEY=

# JPA/Hibernate Configuration
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_HIBERNATE_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Flyway Database Migration
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# OAuth2 / Microsoft Entra ID Configuration
OAUTH2_ISSUER_URI=https://login.microsoftonline.com/common
OAUTH2_JWK_SET_URI=https://login.microsoftonline.com/common/discovery/v2.0/keys
OAUTH2_AUDIENCE=api://chronos

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://app.example.com

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_MAXWELL_CHRONOS=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO

# Application Name
APPLICATION_NAME=Chronos
APPLICATION_VERSION=1.0.0

# Email alerts, reminders, and invitations (configure your SMTP provider)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL_ENABLE=false
# Public HTTPS address for links in reminders and alerts.
CHRONOS_APP_URL=https://app.example.com
# Public HTTPS address for invitation and password reset links.
FRONTEND_URL=https://app.example.com

# Used once, when the database has no Admin. The account receives an
# invitation email through the normal secure account-setup flow.
ADMIN_EMAIL=
