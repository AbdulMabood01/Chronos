      "targets": [
        {"editorMode": "code", "expr": "sum(rate(http_server_requests_seconds_sum{application=\"chronos\", uri!~\"/actuator.*\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"chronos\", uri!~\"/actuator.*\"}[$__rate_interval])), 0.000001)", "legendFormat": "average", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"chronos\", uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "p95", "range": true, "refId": "B"}
