      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"editorMode": "code", "expr": "sum(rate(http_server_requests_seconds_count{application=\"chronos\", uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "requests/sec", "range": true, "refId": "A"}],
      "title": "Request rate",
      "type": "timeseries"
    },
